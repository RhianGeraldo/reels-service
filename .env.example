# Supabase (obrigatório)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...sua_service_role_key...

# Bearer token alternativo para autenticar /edit, /status, /jobs.
# Se vazio, a API só aceita SUPABASE_SERVICE_ROLE_KEY como bearer.
SERVICE_SECRET=troque-isso-por-uma-string-secreta

# Porta do servidor (default 3001; Railway sobrescreve automaticamente)
PORT=3001
